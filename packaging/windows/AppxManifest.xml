<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest template for the Microsoft Store.

  The @PLACEHOLDER@ tokens are substituted by build-msix.ps1 from values you
  reserve in Partner Center (see docs/SIGNING.md). Identity.Name and
  Publisher MUST match your reserved app identity exactly, or the Store
  rejects the upload.

  Capabilities: scrannotate captures the screen. `graphicsCaptureProgrammatic`
  and `graphicsCaptureWithoutBorder` are RESTRICTED capabilities — you declare
  a justification during Store submission, and they can lengthen review. If
  Windows Graphics Capture without these is enough for your build, drop them.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="@IDENTITY_NAME@"
    Publisher="@PUBLISHER@"
    Version="@VERSION@"
    ProcessorArchitecture="@ARCH@" />

  <Properties>
    <DisplayName>scrannotate</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY_NAME@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Screenshot annotation tool: capture a screen, select, annotate in place, copy or save.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.18362.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="scrannotate" Executable="scrannotate.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="scrannotate"
        Description="Screenshot annotation tool: capture a screen, select, annotate in place, copy or save."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="graphicsCaptureProgrammatic" />
    <rescap:Capability Name="graphicsCaptureWithoutBorder" />
  </Capabilities>
</Package>
